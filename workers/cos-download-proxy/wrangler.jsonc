{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "hartlink-download",
  "main": "src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "download.modusignal.cn",
      "custom_domain": true
    }
  ],
  "vars": {
    "COS_BUCKET": "hartlinkstudio-ota-ap-1257631357",
    "COS_REGION": "ap-hongkong",
    "COS_PREFIXES": "HARTLinkStudio/ota,HARTForgeStudio/ota",
    "PUBLIC_HOST": "download.modusignal.cn"
  },
  "d1_databases": [
    {
      "binding": "DOWNLOAD_STATS",
      "database_name": "modusignal-download-stats",
      "database_id": "46971f07-d0c4-4500-bec2-ab0e5391f8ee",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
